          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "applicationId",
                  "assessmentId",
                  "amount",
                  "termMonths"
                ],
                "properties": {
                  "applicationId": {
                    "type": "string"
                  },
                  "assessmentId": {
                    "type": "string"
                  },
                  "amount": {
                    "type": "number"
                  },
                  "termMonths": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Operación completada",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "simulationId",
                    "monthlyPayment",
                    "annualRate",
                    "termMonths"
                  ],
                  "properties": {
                    "simulationId": {
                      "type": "string"
                    },
                    "monthlyPayment": {
                      "type": "number"
                    },
                    "annualRate": {
                      "type": "number"
                    },
                    "termMonths": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Entrada inválida",
            "content": {
