{
  "openapi": "3.1.0",
  "info": {
    "title": "business-loan-simulation-v2",
    "version": "2.0.0",
    "description": "API Business ficticia para demos de diseño de canal."
  },
  "x-demo": true,
  "paths": {
    "/loan-simulations": {
      "post": {
        "operationId": "businessLoanSimulation",
